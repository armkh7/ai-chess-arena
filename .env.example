# Copy this file to `.env` and fill in your values. `.env` is git-ignored.

# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional overrides
# MAX_FULL_MOVES=150   # safety cap per side; games normally end on the board first
# MAX_ILLEGAL_RETRIES=3
# MOVE_TIME_LIMIT_SECONDS=30   # 0 = no limit
# LLM_TIMEOUT_SECONDS=90
# LLM_MAX_TOKENS=8000
# REASONING_EFFORT=low   # low / medium / high; unset = each model's default
# PUBLIC_MODELS_FILE=   # empty = API allows every OpenRouter model; default: backend/public_models.toml
# RATE_LIMIT_RETRIES=4
# RATE_LIMIT_WAIT_SECONDS=15
# STOCKFISH_PATH=stockfish
# ANALYSIS_DEPTH=14
# ANALYSIS_TIME_SECONDS=0.25
# ADJUDICATE_MIN_CP=300
# JUDGE_ENABLED=true   # the judge agent reviews each finished game (needs the key above)
# JUDGE_MODEL=anthropic/claude-haiku-5.5
# JUDGE_REASONING_EFFORT=medium
# JUDGE_TIMEOUT_SECONDS=240
# Cost guards for the public site (0 = no limit; refused requests get HTTP 429)
# GAMES_PER_VISITOR_PER_HOUR=3   # per IP address
# GAMES_PER_DAY=50   # whole site, resets at midnight UTC
# MAX_WAITING_GAMES=5   # queue beyond MAX_CONCURRENT_GAMES
# MAX_CONCURRENT_GAMES=3
# New games pause while the OpenRouter credit left (the lower of the key's limit and the
# account balance) is under this; the home page then says games are paused. 0 = no check.
# MIN_CREDITS_USD=0.5
# GAMES_PAUSED=false   # true = pause new games by hand

# Database for the API when it runs on your machine (`uv run uvicorn app.main:app`).
# Docker Compose builds its own DATABASE_URL from the POSTGRES_* values below.
DATABASE_URL=postgresql+psycopg://arena:arena@localhost:5432/arena

# Postgres (Docker Compose). On a server, use a long random password: openssl rand -hex 24
POSTGRES_USER=arena
POSTGRES_PASSWORD=arena
POSTGRES_DB=arena

# Production (docker-compose.prod.yml): local ports the server's nginx forwards to.
# Pick ports nothing else on the server uses.
# ARENA_WEB_PORT=3100
# ARENA_API_PORT=8100
