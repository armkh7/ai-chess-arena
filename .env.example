# Copy this file to `.env` and fill in your values. `.env` is git-ignored.

# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional overrides
# MAX_FULL_MOVES=60
# MAX_ILLEGAL_RETRIES=3
# MOVE_TIME_LIMIT_SECONDS=30   # 0 = no limit
# LLM_TIMEOUT_SECONDS=90
# LLM_MAX_TOKENS=8000
# REASONING_EFFORT=low   # low / medium / high; unset = each model's default
# RATE_LIMIT_RETRIES=4
# RATE_LIMIT_WAIT_SECONDS=15
# STOCKFISH_PATH=stockfish
# ANALYSIS_DEPTH=14
# ANALYSIS_TIME_SECONDS=0.25
# ADJUDICATE_MIN_CP=300

# Postgres (Docker Compose)
POSTGRES_USER=arena
POSTGRES_PASSWORD=arena
POSTGRES_DB=arena
